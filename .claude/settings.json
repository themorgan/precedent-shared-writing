{
  "_comment": [
    "Written by tools/precedent_bootstrap_source.py. The base branch is",
    "passed to freshness-guard.sh explicitly, as its second argument, and",
    "is not detected: at least one real repo's configured default branch is",
    "not the branch its work sits on top of. Change it here if this source's",
    "is not `main`.",
    "",
    "The PreToolUse matcher includes Bash deliberately -- an agent editing",
    "files through cat/sed/python3 never touches Edit or Write at all.",
    "",
    "No env identity is set here: a source repo may have more than one",
    "person committing to it, and commit-identity.sh resolves each of them",
    "at session start instead of anybody being named in a tracked file."
  ],
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/precedent-individual-bootstrap.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/precedent-universal-catalogue.sh"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/freshness-guard.sh session-start main"
          },
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/commit-identity.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/freshness-guard.sh pre-write main"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/doc-lint-gate.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/push-check-gate.sh",
            "timeout": 900
          }
        ]
      },
      {
        "matcher": "mcp__.*__(create_session|create_trigger|update_trigger|fire_trigger|send_later)",
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/seeded-prompt-gate.sh"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/freshness-guard.sh user-prompt main"
          }
        ]
      }
    ]
  }
}
